# Polygraph runtime environment. Copy to .env for local work (gitignored) or set
# these in the service environment. Secrets never belong in a config file.

# --- Required for `serve` / `npm run local` ---------------------------------
# Exactly 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Encrypts every tenant's Bright Data key, ingest tokens and stored run inputs.
# Loses this and every stored secret is unrecoverable.
POLYGRAPH_MASTER_KEY=

# SQLite file. Must live on persistent disk in production. Default ./polygraph.sqlite
POLYGRAPH_DB=./polygraph.sqlite

# The origin browsers will use. CSRF compares the Origin header to this string
# exactly, so it must match what you type in the address bar (scheme, host, port).
# Default http://localhost:<PORT>
POLYGRAPH_PUBLIC_ORIGIN=http://localhost:8080

# Listen port, default 8080.
PORT=8080

# --- Automatic collector recovery --------------------------------------------
# 1 = the worker repairs broken collectors through Bright Data Self-Healing and
# verifies with a fresh run. Unset = deliveries are graded and ledgered, but
# nothing is mutated at the provider. Re-read live at every gate.
POLYGRAPH_AUTO_RECOVERY=

# Optional Telegram alerts on cycle start / verified / held. Set BOTH or neither.
POLYGRAPH_TELEGRAM_BOT_TOKEN=
POLYGRAPH_TELEGRAM_CHAT_ID=

# --- Optional -----------------------------------------------------------------
# Google sign-in. Without it /api/auth/google answers 503 and the wizard uses an
# anonymous local workspace.
GOOGLE_OAUTH_CLIENT_ID=

# Previous master key, only while running `polygraph admin rekey`.
POLYGRAPH_MASTER_KEY_PREVIOUS=

# Scheduler fan-out for hosted adapter runs (dormant unless a collector has next_run_at).
POLYGRAPH_CONCURRENCY=4

# --- CLI / offline tooling (not used by the hosted server) --------------------
# fleet.yaml path for `run`, `watch`, `demo`, `mcp`. Default ./fleet.yaml
POLYGRAPH_CONFIG=./fleet.yaml
# Only for the CLI adapters; hosted tenants supply their own key through the UI.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
# MCP: network-backed verification runs are off unless this is 1 (and confirmed per call).
POLYGRAPH_MCP_ALLOW_NETWORK=

# --- Live-proof demo mission (the landing page's real Bright Data loop) -------
# Gemini advisor for the demo mission only. Unset = no advisor is constructed.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
POLYGRAPH_GEMINI_MODEL=gemini-3.1-flash-lite
# See deploy/gcp-startup.sh for the full POLYGRAPH_DEMO_* set.
