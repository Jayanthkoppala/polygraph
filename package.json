{
  "name": "polygraph-data",
  "version": "0.1.0",
  "description": "Evidence gate for scraper fleets — independently re-verifies a collector's output and only lets a repair through when it has live proof the repair is warranted",
  "keywords": [
    "scraping",
    "web-scraping",
    "brightdata",
    "data-quality",
    "verification",
    "self-healing",
    "monitoring",
    "cli"
  ],
  "license": "MIT",
  "author": "Jayanth Koppala <jayanth.sms.in@gmail.com>",
  "homepage": "https://github.com/Jayanthkoppala/polygraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayanthkoppala/polygraph.git"
  },
  "bugs": {
    "url": "https://github.com/Jayanthkoppala/polygraph/issues"
  },
  "type": "module",
  "bin": {
    "polygraph": "./dist/index.js",
    "polygraph-data": "./dist/index.js"
  },
  "files": [
    "dist/",
    "app/dist/",
    "docs/AI-ASSISTANCE.md",
    "docs/MCP.md",
    "docs/demo.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:app": "npm --prefix app run build",
    "build:all": "npm run build && npm run build:app",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run test && npm --prefix app run test",
    "dev": "tsx src/index.ts",
    "demo": "tsx src/index.ts demo",
    "mcp": "tsx src/index.ts mcp",
    "serve": "tsx src/index.ts serve",
    "progress": "node scripts/progress.mjs",
    "prepublishOnly": "npm run build:all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "google-auth-library": "^11.0.2",
    "node-cron": "^4.6.0",
    "yaml": "^2.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
